# Copy this file to .env and fill in your keys. .env is never committed.

# Prices: OS AI data works with no key.
# Markets: meme coins by default (DOGE, SHIB, PEPE, BONK, WIF, FLOKI). "all" adds forex, gold and
# bitcoin; or list symbols, e.g. MARKETS=DOGEUSD,SHIBUSD,BTCUSD
MARKETS=

# Optional: lets Claude analyze research sources (otherwise a free keyword classifier is used)
ANTHROPIC_API_KEY=
# Thinking budget in USD for Claude calls; research pauses when it is used up
BUDGET=50

# Optional extra sources
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# When hosted publicly: password for the dashboard (any username)
DASHBOARD_PASSWORD=
# Sites allowed to embed the dashboard; add your store's own domain if it has one
FRAME_ANCESTORS='self' https://ostradingai.com https://*.ostradingai.com https://*.myshopify.com https://admin.shopify.com

# DEX desk: scans DexScreener for on-chain meme coins and paper-trades the ones that pass its safety
# filter (see docs/DEX.md). robinhood = https://dexscreener.com/robinhood; off = no desk.
DEX_CHAIN=robinhood
DEX_PAPER_USD=100
DEX_MIN_LIQUIDITY=25000
DEX_MIN_VOLUME=25000
DEX_MIN_AGE_HOURS=6

# Live trading on a crypto exchange (see docs/EXCHANGE.md). Inactive until these are set and you
# press Arm on the dashboard (which needs DASHBOARD_PASSWORD). Create the API key with trading
# permission only, never withdrawals. Put real values in your host's environment variables.
EXCHANGE=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# Only some exchanges (OKX, KuCoin, Coinbase Exchange) need a passphrase
EXCHANGE_PASSPHRASE=
# 1 = the exchange's test network with play money (Binance, Bybit, OKX and others)
EXCHANGE_SANDBOX=1
# Coin the account pays with: USDT on most exchanges, USD on Kraken and Coinbase
EXCHANGE_QUOTE=USDT
TRADE_USD=20
MAX_TRADE_USD=100
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=50
