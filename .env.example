# Copy this file to .env and fill in your keys. .env is never committed.

# Prices: OS AI data works with no key. Optional: an OANDA v20 token switches to OANDA's feed
# with real bid/ask spreads.
OANDA_API_KEY=
OANDA_ENV=practice

# Optional: lets Claude analyze research sources (otherwise a free keyword classifier is used)
ANTHROPIC_API_KEY=
# Thinking budget in USD for Claude calls; research pauses when it is used up
BUDGET=50

# Optional extra sources
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# When hosted publicly: password for the dashboard (any username)
DASHBOARD_PASSWORD=
# Sites allowed to embed the dashboard; add your store's own domain if it has one
FRAME_ANCESTORS='self' https://ostradingai.com https://*.ostradingai.com https://*.myshopify.com https://admin.shopify.com

# MetaTrader live trading (see docs/METATRADER.md). Inactive until BRIDGE_TOKEN is set and you
# press Arm on the dashboard (which needs DASHBOARD_PASSWORD).
BRIDGE_TOKEN=
LIVE_LOTS=0.01
MAX_LOTS=0.1
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=100
